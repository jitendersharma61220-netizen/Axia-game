# Where the NestJS API listens (server-side proxy target).
API_URL=http://localhost:4000
# Same OAuth client ID as the API's GOOGLE_CLIENT_ID. Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Shows the developer sign-in form. Must match the API's ALLOW_DEV_LOGIN. Never enable in production.
NEXT_PUBLIC_ALLOW_DEV_LOGIN=true
