DATABASE_URL=postgresql://axia:axia@localhost:5432/axia?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
# OAuth client ID from Google Cloud Console (Web application). Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Lets you sign in without Google during local development. Never enable in production.
ALLOW_DEV_LOGIN=true
# Comma-separated emails that are promoted to ADMIN on sign-in.
ADMIN_EMAILS=admin@axia.local
PORT=4000
WEB_ORIGIN=http://localhost:3000
