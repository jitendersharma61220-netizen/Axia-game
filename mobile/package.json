{
  "name": "patang-rush-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Patang Rush for Android: Phaser 4 game wrapped with Capacitor 8.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "sync": "npm run build && cap sync android",
    "open": "cap open android",
    "assets": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "phaser": "^4.2.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "typescript": "~5.9.0",
    "vite": "^8.3.8"
  }
}
