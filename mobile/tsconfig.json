{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@axia/engine": ["../packages/engine/src/index.ts"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"]
}
