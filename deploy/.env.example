# Copy to deploy/.env and fill in. Never commit the real file.

# Your domain, already pointing (DNS A record) at this server's IP.
DOMAIN=play.example.com

# Long random values. Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised JavaScript origin: https://<DOMAIN>
GOOGLE_CLIENT_ID=

# Comma-separated Google emails that become admins on first sign-in.
ADMIN_EMAILS=you@gmail.com

# invite = closed beta (invite code or friend's challenge link needed); open = anyone can join.
SIGNUP_MODE=invite
